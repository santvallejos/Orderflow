      "isDeleted": false,
      "boundElements": null,
      "updated": 1763211666333,
      "link": null,
      "locked": false,
      "text": "El corazon de nuestra aplicación,\ndefine las reglas y conceptos\nfundamentales de las reglas de\nnegocios.\nLo que cambiemos externamente\nno tendría porque afectar\ninternamente.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El corazon de nuestra aplicación, define las reglas y conceptos fundamentales de las reglas de negocios.\nLo que cambiemos externamente no tendría porque afectar internamente.",
      "autoResize": false,
      "lineHeight": 1.25
    },
